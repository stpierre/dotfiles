#!/bin/zsh

_current_git_repo=
_current_git_branch=
_current_git_unpushed=

_has_gh=
if type gh >& /dev/null; then
    _has_gh=1
fi

_parse_git_repo() {
    if [[ $_has_gh -eq 1 ]]; then
        _current_git_repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2> /dev/null)"
    fi
    if [[ -z $_current_git_repo && -d .git ]]; then
        _current_git_repo="$(git remote -v 2> /dev/null | \
          awk '/^origin[[:space:]].*\(fetch\)$/ {
                   split($2,a,"[:/]");
                   sub(/\.git$/, "", a[length(a)]);
                   print a[length(a)]; }' | \
          tail -n 1)"
        if [[ -z $_current_git_repo ]]; then
            _current_git_repo="$(basename "$(pwd)")"
        fi
    fi

    if [[ -n $_current_git_repo && \
              $_current_git_repo != "dotfiles" && \
              $_current_git_repo != */dotfiles \
        ]]; then
        _current_git_branch="$(git what-branch)"
        local _unpushed="$(git log @{u}.. --oneline 2>&1)"
        if [[ -n $_unpushed ]] && ! echo "$_unpushed" | grep -q fatal; then
            _current_git_unpushed="$(echo $_unpushed | wc -l | tr -d ' ')"
        else
            _current_git_unpushed=
        fi
    else
        _current_git_branch=
        _current_git_unpushed=
    fi
}

_zsh_update_git_vars() {
    case "$1" in
        *git*)
            _parse_git_repo
            ;;
        g\ *)
            _parse_git_repo
            ;;
    esac
}

_get_git_prompt_info() {
    if [[ -n $_current_git_repo && -n $_current_git_branch ]]; then
        echo -n "$_current_git_repo:$_current_git_branch"
        if [[ $_current_git_unpushed > 0 ]]; then
            echo -n " %B($_current_git_unpushed)%b"
        fi
    fi
}

if type git >& /dev/null; then
    add_prompt_hook _get_git_prompt_info

    if [[ $(type git) == "git is a shell function" ]]; then
        unfunction git
    fi

    # we run parse_git_repo and parse_git_branch on three occasions:
    #
    # 1.  When this file is first loaded;
    # 2.  When a git command is run; and
    # 3.  When cd is run
    _parse_git_repo
    add-zsh-hook preexec _zsh_update_git_vars
    add-zsh-hook chpwd _parse_git_repo

    if type hub >& /dev/null; then
        eval "$(hub alias -s)"
    fi

    alias g=git
    alias gg='git grep'

    if type git-spice >& /dev/null; then
        alias gs='git spice'
    fi
fi

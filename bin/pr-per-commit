#!/bin/bash
#
# Enter one PR per commit on the current branch.
#
# Optionally sleeps between each PR to avoid overloading CI. This branch is
# compared with the primary branch as found by `git primary-branch`

set -euo pipefail

SCRIPT=$(basename "$0")

sleep=0

usage() {
    cat <<EOUSAGE >&2
Usage: $SCRIPT [-s <sleep>]
Options:
  -s <sleep>: Sleep for <sleep> seconds between PRs. Default: ${sleep}s
EOUSAGE
}

while getopts ":hs:" opt; do
    case $opt in
        s)
            sleep=$OPTARG
            ;;
        h)
            usage
            exit 0
            ;;
        \?)
            usage
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

current_branch="$(git rev-parse --abbrev-ref HEAD)"
primary_branch="$(git primary-branch)"

remaining=$(git cherry "$primary_branch" | grep -c '^+')
git cherry "$primary_branch" | awk '/^+/ { print $NF }' | \
    while read -r hash; do
        if [[ $current_branch != "HEAD" ]]; then
            git checkout "$current_branch"
        fi

        pr-from-commit "$hash"

        remaining=$((remaining - 1))
        if [[ $remaining -gt 0 ]]; then
            sleep "$sleep"
        fi
    done
